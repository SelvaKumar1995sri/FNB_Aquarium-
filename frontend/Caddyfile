# Serve the same content on plain HTTP (port 80, bare IP or hostname) AND
# HTTPS (port 443, hostname only). Do NOT force-redirect HTTP -> HTTPS here:
# if port 443 ever becomes unreachable (security group misconfigured, ISP/
# firewall blocking it, etc.) a redirect would break plain HTTP too, which
# worked fine before HTTPS was added. Explicit http:// entries below stop
# Caddy's automatic-HTTPS redirect from kicking in for this hostname.
fnbaqua.13.50.60.19.nip.io, http://fnbaqua.13.50.60.19.nip.io, http://13.50.60.19 {
	encode gzip

	# Django serves this itself via whitenoise, regardless of DEBUG.
	handle /static/* {
		reverse_proxy backend:8000
	}

	# Django only serves /media/ when DEBUG=True, so in staging Caddy reads
	# it directly off the volume shared with the backend container instead.
	handle_path /media/* {
		root * /media
		file_server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /admin/* {
		reverse_proxy backend:8000
	}

	# React Router SPA — unknown paths fall back to index.html.
	handle {
		root * /usr/share/caddy/html
		try_files {path} /index.html
		file_server
	}
}
