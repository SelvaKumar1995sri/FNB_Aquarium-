# Copy this to backend/.env on the EC2 instance (NOT committed to git) and
# fill in real values before running `docker compose up`.

DJANGO_SETTINGS_MODULE=config.settings.staging
SECRET_KEY=generate-a-real-random-50-plus-character-value
DEBUG=False

# The EC2 instance's public IP (or Elastic IP), e.g. 13.234.56.78
ALLOWED_HOSTS=<EC2_PUBLIC_IP>
CORS_ALLOWED_ORIGINS=http://<EC2_PUBLIC_IP>

# "db" is the docker-compose service name, not localhost — containers reach
# each other by service name over the compose network.
DATABASE_URL=postgres://fnbaqua:fnbaqua@db:5432/fnbaqua

# Real Razorpay TEST-mode keys — see backend/RAZORPAY_SETUP.md
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_chosen_webhook_secret
