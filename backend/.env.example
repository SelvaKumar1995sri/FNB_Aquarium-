# Only affects manage.py (local dev commands) — wsgi.py requires this to be
# set explicitly in the real deployment environment, no default is applied there.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-real-random-secret-at-least-50-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://fnbaqua:fnbaqua@localhost:5432/fnbaqua
CORS_ALLOWED_ORIGINS=http://localhost:5173
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
